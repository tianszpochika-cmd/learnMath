{
  "name": "learnmath",
  "version": "0.1.0",
  "private": true,
  "description": "数学学习平台（数源 MathOrigin）— Web 学习端 + 管理端 + 官网 + uniapp 移动端",
  "engines": {
    "node": "20.19.5",
    "pnpm": "10.19.0"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "design:check": "node scripts/check-design-contracts.mjs",
    "dev": "turbo dev",
    "dev:all": "pnpm ports:check && turbo dev",
    "dev:web": "pnpm --filter @learnmath/web dev",
    "dev:admin": "pnpm --filter @learnmath/admin dev",
    "dev:official": "pnpm --filter @learnmath/official dev",
    "dev:uniapp:h5": "pnpm --filter @learnmath/uniapp dev:h5",
    "ports:check": "node scripts/check-fixed-ports.mjs",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "build": "turbo build",
    "build:web": "pnpm --filter @learnmath/web build",
    "build:admin": "pnpm --filter @learnmath/admin build",
    "build:official": "pnpm --filter @learnmath/official build",
    "build:uniapp:h5": "pnpm --filter @learnmath/uniapp build:h5",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
